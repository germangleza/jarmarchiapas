---
import { site } from "../../site.config.mjs";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  image?: string;
  url: string;
  keywords?: string[];
  faq?: { question: string; answer: string }[];
  sources?: { title: string; url: string }[];
}
const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  image,
  url,
  keywords = [],
  faq = [],
  sources = [],
} = Astro.props;

// Schema BlogPosting: lo que hace que ChatGPT / Perplexity
// entiendan quién publica, cuándo y de qué trata.
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    "@type": "Organization",
    name: author,
    url: site.url,
  },
  publisher: {
    "@type": site.org.type,
    name: site.org.legalName,
    logo: {
      "@type": "ImageObject",
      url: new URL(site.org.logo, site.url).toString(),
    },
    ...(site.org.sameAs?.length ? { sameAs: site.org.sameAs } : {}),
  },
  ...(image ? { image: new URL(image, site.url).toString() } : {}),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": url,
  },
  inLanguage: site.lang,
  ...(keywords.length ? { keywords: keywords.join(", ") } : {}),
  ...(sources.length
    ? { citation: sources.map((s) => ({ "@type": "CreativeWork", name: s.title, url: s.url })) }
    : {}),
};

// FAQPage: sale de la sección "## Preguntas frecuentes" del post (texto idéntico).
const faqSchema = faq.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    }
  : null;
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
{faqSchema && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />
)}
