---
// CTA "Agendar cita" hacia WhatsApp que va al final de cada sección de las
// páginas de servicio y sucursal. `ciudad="general"` muestra un botón por ciudad.
interface Props {
  ciudad: "tuxtla" | "tijuana" | "general";
  /** Nombre del servicio para el mensaje prellenado (p. ej. "Lentes Esclerales"). */
  servicio?: string;
  /** WhatsApp propio (sucursales); si no, se usa el de la ciudad. */
  whatsapp?: string;
  lang?: "es" | "en";
}

const { ciudad, servicio, whatsapp, lang = "es" } = Astro.props;

const numeros = { tuxtla: "529611855475", tijuana: "526645791970" };
const nombreCiudad = { tuxtla: "Tuxtla", tijuana: "Tijuana" };

const link = (c: "tuxtla" | "tijuana") => {
  const texto =
    lang === "en"
      ? `Hi, I'd like to book an appointment${servicio ? ` for ${servicio}` : ""} at Ópticas Jarmar Tijuana.`
      : `Hola, quiero agendar una cita${servicio ? ` para ${servicio}` : ""} en Ópticas Jarmar ${nombreCiudad[c]}.`;
  return `https://wa.me/${numeros[c]}?text=${encodeURIComponent(texto)}`;
};

const botones =
  ciudad === "general"
    ? [
        { href: link("tuxtla"), label: "Agendar cita en Chiapas" },
        { href: link("tijuana"), label: "Agendar cita en Tijuana" },
      ]
    : [
        {
          href: whatsapp ?? link(ciudad),
          label: lang === "en" ? "Book an appointment on WhatsApp" : "Agendar cita por WhatsApp",
        },
      ];

const frase =
  lang === "en"
    ? "Every case is different: book your appointment and we'll assess yours in person."
    : "Cada caso es distinto: agenda tu cita y lo valoramos en consulta.";
---

<div class="cta-cita">
  <p>{frase}</p>
  <div class="cta-cita__btns">
    {botones.map((b) => (
      <a href={b.href} target="_blank" rel="noopener" class="cta-cita__btn">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35ZM12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.42 9.42 0 0 1-1.44-5.02C2.6 6.86 6.84 2.62 12.05 2.62c2.52 0 4.89.99 6.67 2.77a9.37 9.37 0 0 1 2.76 6.67c0 5.2-4.24 9.44-9.44 9.44Zm8.03-17.47A11.27 11.27 0 0 0 12.04.7C5.8.7.72 5.78.72 12.03c0 2 .52 3.94 1.52 5.66L.62 23.3l5.75-1.5a11.3 11.3 0 0 0 5.67 1.44h.01c6.24 0 11.32-5.08 11.33-11.32 0-3.03-1.18-5.87-3.31-8Z"/></svg>
        {b.label}
      </a>
    ))}
  </div>
</div>

<style>
  .cta-cita {
    margin-top: 40px;
    padding: 22px 26px;
    border-radius: 18px;
    background: rgba(58, 143, 224, 0.08);
    border: 1.5px solid rgba(58, 143, 224, 0.25);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .cta-cita p {
    margin: 0;
    color: #071A3E;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    flex: 1 1 260px;
  }
  .cta-cita__btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .cta-cita__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #128043;
    color: #fff;
    padding: 12px 24px;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.97rem;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }
  .cta-cita__btn:hover { opacity: 0.9; transform: translateY(-2px); color: #fff; }
  @media (max-width: 640px) {
    .cta-cita { padding: 20px; }
    .cta-cita__btns, .cta-cita__btn { width: 100%; justify-content: center; }
  }
</style>
