---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Ubicaciones y Citas en Chiapas | Ópticas Jarmar"
  description="Agenda tu cita por WhatsApp o encuentra la ubicación de nuestras dos sucursales en Tuxtla Gutiérrez: Plaza Cedros (Arboledas) y Plaza Crystal."
>
  <style>
    :root {
      --bg: #071A3E;
      --surface: #0D2B6B;
      --accent: #3A8FE0;
      --azul-medio: #1A5BB5;
      --gris-texto: #4A5568;
      --verde-wa: #25D366;
    }

    .hero {
      background: linear-gradient(135deg, var(--bg) 0%, var(--surface) 100%);
      color: #fff;
      padding: 64px 20px 56px;
      text-align: center;
    }
    .hero-handle {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 4vw, 2rem);
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 10px;
    }
    .hero p {
      font-size: 1.02rem;
      opacity: 0.85;
      max-width: 480px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .container { max-width: 560px; margin: 0 auto; padding: 0 20px; }

    .sucursales-section { background: #F7F9FC; padding: 48px 20px 64px; }

    .sucursal-label {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--azul-medio);
      text-align: center;
      margin: 40px 0 16px;
    }
    .sucursal-label:first-child { margin-top: 0; }

    .sucursal-card {
      background: #fff;
      border-radius: 20px;
      border: 1px solid rgba(13,43,107,0.08);
      box-shadow: 0 4px 20px rgba(13,43,107,0.06);
      padding: 24px;
      margin-bottom: 12px;
    }
    .sucursal-card h2 {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--bg);
      margin-bottom: 2px;
    }
    .sucursal-card .sucursal-ciudad {
      font-size: 0.88rem;
      color: var(--gris-texto);
      margin-bottom: 18px;
    }

    .link-btn {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 15px 18px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.98rem;
      text-decoration: none;
      color: #fff;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      margin-bottom: 10px;
    }
    .link-btn:last-child { margin-bottom: 0; }
    .link-btn:hover { transform: translateY(-2px); }
    .link-btn svg { flex-shrink: 0; }
    .link-btn .link-btn-text { flex: 1; text-align: left; }
    .link-btn .link-btn-sub {
      display: block;
      font-weight: 400;
      font-size: 0.78rem;
      opacity: 0.85;
      margin-top: 1px;
    }

    .link-btn--wa {
      background: var(--verde-wa);
      box-shadow: 0 4px 14px rgba(37,211,102,0.3);
    }
    .link-btn--wa:hover { box-shadow: 0 8px 22px rgba(37,211,102,0.4); }

    .link-btn--maps {
      background: var(--bg);
      box-shadow: 0 4px 14px rgba(7,26,62,0.25);
    }
    .link-btn--maps:hover { box-shadow: 0 8px 22px rgba(7,26,62,0.35); }

    .social-row {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin-top: 40px;
    }
    .social-btn {
      width: 46px; height: 46px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid rgba(13,43,107,0.12);
      display: flex; align-items: center; justify-content: center;
      color: var(--azul-medio);
      transition: var(--trans, all 0.2s ease);
    }
    .social-btn:hover { background: var(--azul-medio); color: #fff; }

    .footer-note {
      text-align: center;
      color: var(--gris-texto);
      font-size: 0.82rem;
      margin-top: 28px;
      opacity: 0.75;
    }
    .footer-note a { color: var(--azul-medio); font-weight: 600; }

    @media (max-width: 480px) {
      .hero { padding: 48px 20px 44px; }
      .sucursales-section { padding: 36px 16px 48px; }
    }
  </style>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <p class="hero-handle">@opticasjarmar</p>
      <p>60 años cuidando la salud visual de las familias chiapanecas. Elige tu sucursal para agendar cita o ver la ubicación.</p>
    </div>
  </section>

  <!-- SUCURSALES -->
  <section class="sucursales-section">
    <div class="container">

      <p class="sucursal-label">Sucursal Plaza Cedros · Arboledas</p>
      <div class="sucursal-card">
        <h2>Plaza Cedros, Col. Arboledas</h2>
        <p class="sucursal-ciudad">Tuxtla Gutiérrez, Chiapas</p>

        <a
          href="https://wa.me/529612406013?text=Hola,%20me%20gustar%C3%ADa%20agendar%20una%20cita%20en%20%C3%93pticas%20Jarmar%20Plaza%20Cedros"
          target="_blank"
          class="link-btn link-btn--wa"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.117.549 4.107 1.514 5.836L.057 23.215a.75.75 0 00.918.899l5.444-1.428A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
          <span class="link-btn-text">
            WhatsApp Arboledas — Citas
            <span class="link-btn-sub">961 240 6013</span>
          </span>
        </a>

        <a
          href="https://maps.app.goo.gl/g2ZZd4kXs5LiX5H57"
          target="_blank"
          class="link-btn link-btn--maps"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="link-btn-text">
            Ver ubicación
            <span class="link-btn-sub">Plaza Cedros, Col. Arboledas</span>
          </span>
        </a>
      </div>

      <p class="sucursal-label">Sucursal Plaza Crystal</p>
      <div class="sucursal-card">
        <h2>Plaza Crystal</h2>
        <p class="sucursal-ciudad">Tuxtla Gutiérrez, Chiapas</p>

        <a
          href="https://wa.me/529611855475?text=Hola,%20me%20gustar%C3%ADa%20agendar%20una%20cita%20en%20%C3%93pticas%20Jarmar%20Plaza%20Crystal"
          target="_blank"
          class="link-btn link-btn--wa"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.117.549 4.107 1.514 5.836L.057 23.215a.75.75 0 00.918.899l5.444-1.428A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
          <span class="link-btn-text">
            WhatsApp Plaza Crystal — Citas
            <span class="link-btn-sub">961 185 5475</span>
          </span>
        </a>

        <a
          href="https://maps.app.goo.gl/3cwL8wvXXwQtokMz9"
          target="_blank"
          class="link-btn link-btn--maps"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="link-btn-text">
            Ver ubicación
            <span class="link-btn-sub">Plaza Crystal</span>
          </span>
        </a>
      </div>

      <!-- REDES -->
      <div class="social-row">
        <a href="https://www.instagram.com/opticasjarmar/" target="_blank" class="social-btn" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.facebook.com/opticasjarmarchiapas" target="_blank" class="social-btn" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
        </a>
      </div>

      <p class="footer-note">¿Buscas Tijuana? <a href="/tijuana/">Ve nuestra sucursal allá →</a></p>
    </div>
  </section>
</BaseLayout>
