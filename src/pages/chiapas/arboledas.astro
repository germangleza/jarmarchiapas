---
import BaseLayout from "../../layouts/BaseLayout.astro";

const sucursal = {
  nombre: "Ópticas Jarmar Arboledas",
  direccion: "Plaza Cedros, Col. Arboledas",
  ciudad: "Tuxtla Gutiérrez",
  estado: "Chiapas",
  telefono: "961 240 6013",
  telefonoIntl: "+529612406013",
  whatsapp: "https://wa.me/529612406013?text=Hola%2C%20quiero%20agendar%20una%20cita%20en%20%C3%93pticas%20Jarmar%20Arboledas.",
  mapa: "https://maps.app.goo.gl/g2ZZd4kXs5LiX5H57",
  embed: "https://www.google.com/maps?q=%C3%93pticas%20Jarmar%20Plaza%20Cedros%20Arboledas%20Tuxtla%20Guti%C3%A9rrez&output=embed",
};

// Fuente única de la FAQ: el texto visible y el JSON-LD salen de aquí,
// así nunca se desincronizan (ver CLAUDE.md → Schema).
const faq = [
  {
    q: "¿Dónde está Ópticas Jarmar Arboledas?",
    a: "Estamos en Plaza Cedros, sobre la Col. Arboledas, en Tuxtla Gutiérrez, Chiapas. Es nuestra sede clínica en la ciudad y cuenta con estacionamiento dentro de la plaza. Desde el mapa de esta página puedes abrir la ruta directa en Google Maps.",
  },
  {
    q: "¿Cuál es el horario de la sucursal Arboledas?",
    a: "Atendemos de lunes a viernes de 9:00 a 20:00 y los sábados de 9:00 a 18:00. Para domingos y días festivos te recomendamos confirmar el horario por WhatsApp al 961 240 6013 antes de venir.",
  },
  {
    q: "¿Necesito cita para que me atiendan en Arboledas?",
    a: "Puedes llegar sin cita, pero te recomendamos agendar por WhatsApp al 961 240 6013 para que el optometrista tenga el tiempo completo reservado para tu evaluación y no tengas que esperar.",
  },
  {
    q: "¿Qué es el Centro Visual de la sucursal Arboledas?",
    a: "Es el espacio que abrimos en 2020 dentro de esta misma sede, en alianza con el centro oftalmológico de referencia en Chiapas. Nos permite que, cuando una revisión detecta algo que necesita valoración médica, el paciente sea referido con oftalmología sin salir del mismo lugar.",
  },
  {
    q: "¿Adaptan lentes esclerales en la sucursal Arboledas?",
    a: "Sí. Contamos con el área de contactología especializada, con más de 10 años adaptando lentes esclerales para queratocono, córneas irregulares, post-trasplante de córnea y ojo seco severo. Es una valoración que conviene agendar con anticipación.",
  },
  {
    q: "¿Aceptan el beneficio de visión de mi seguro?",
    a: "Sí. Aceptamos el beneficio de visión de cualquier aseguradora. Trae tu póliza o la carta de tu seguro y te ayudamos a aplicarla en tu examen de la vista y en tus lentes.",
  },
];

const localBusiness = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "Optician"],
  "@id": "https://www.jarmar.com/chiapas/arboledas/#local",
  name: "Ópticas Jarmar Arboledas",
  alternateName: "Ópticas Jarmar — Plaza Cedros",
  parentOrganization: { "@id": "https://www.jarmar.com/#organization" },
  url: "https://www.jarmar.com/chiapas/arboledas/",
  image: "https://www.jarmar.com/apertura-centro-visual-jarmar.jpg",
  telephone: "+52-961-240-6013",
  priceRange: "$$",
  currenciesAccepted: "MXN",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Plaza Cedros, Col. Arboledas",
    addressLocality: "Tuxtla Gutiérrez",
    addressRegion: "Chiapas",
    addressCountry: "MX",
  },
  geo: { "@type": "GeoCoordinates", latitude: "16.7516", longitude: "-93.1153" },
  hasMap: "https://maps.app.goo.gl/g2ZZd4kXs5LiX5H57",
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "20:00",
    },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "09:00", closes: "18:00" },
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.9",
    reviewCount: "880",
    bestRating: "5",
    worstRating: "1",
  },
  sameAs: [
    "https://www.facebook.com/opticasjarmarchiapas",
    "https://www.instagram.com/opticasjarmar/",
    "https://wa.me/529612406013",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios en Ópticas Jarmar Arboledas",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Estudio de la vista" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Lentes graduados" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Lentes de contacto" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Lentes esclerales" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Examen visual infantil" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Jarmar Eyewear" } },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://www.jarmar.com/chiapas/arboledas/#faq",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.jarmar.com/" },
    { "@type": "ListItem", position: 2, name: "Chiapas", item: "https://www.jarmar.com/chiapas/" },
    { "@type": "ListItem", position: 3, name: "Arboledas", item: "https://www.jarmar.com/chiapas/arboledas/" },
  ],
};
---

<BaseLayout
  title="Óptica en Tuxtla Gutiérrez | Ópticas Jarmar Arboledas"
  description="Ópticas Jarmar Arboledas: óptica en Tuxtla Gutiérrez en Plaza Cedros. Examen de la vista, lentes graduados y de contacto. Horario, teléfono, WhatsApp y cómo llegar."
  ogImage="https://www.jarmar.com/apertura-centro-visual-jarmar.jpg"
>
  <Fragment slot="head">
    <meta name="geo.region" content="MX-CHP" />
    <meta name="geo.placename" content="Tuxtla Gutiérrez, Chiapas, México" />
    <meta name="geo.position" content="16.7516;-93.1153" />
    <meta name="ICBM" content="16.7516, -93.1153" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </Fragment>

  <style>
    :root {
      --bg: #071A3E;
      --surface: #0D2B6B;
      --accent: #3A8FE0;
      --gris: #4A5568;
      --verde-wa: #25D366;
    }

    .container { max-width: 900px; margin: 0 auto; padding: 0 20px; }

    /* HERO */
    .hero {
      background: linear-gradient(135deg, var(--bg) 0%, var(--surface) 100%);
      color: #fff;
      padding: 92px 20px 72px;
      text-align: center;
    }
    .hero-tag {
      display: inline-block;
      background: rgba(58,143,224,0.2);
      border: 1px solid var(--accent);
      color: var(--accent);
      border-radius: 100px;
      padding: 6px 18px;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 24px;
    }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(1.9rem, 5vw, 3rem);
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 20px;
    }
    .hero h1 span { color: var(--accent); }
    .hero p {
      font-size: 1.08rem;
      opacity: 0.88;
      max-width: 660px;
      margin: 0 auto 32px;
      line-height: 1.75;
    }
    .hero-rating {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.9rem;
      color: rgba(255,255,255,0.8);
      margin-bottom: 28px;
    }
    .hero-rating .stars { color: #F6AD55; letter-spacing: 1px; }

    .btn-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
    .btn-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 100px;
      font-weight: 700;
      font-size: 0.98rem;
      text-decoration: none;
      transition: opacity 0.2s, transform 0.2s;
    }
    .btn-cta:hover { opacity: 0.92; transform: translateY(-2px); }
    .btn-wa { background: var(--verde-wa); color: #fff; }
    .btn-tel { background: var(--accent); color: #fff; }
    .btn-ghost { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.5); }

    /* SECCIONES */
    .section { padding: 68px 20px; }
    .section--alt { background: #f7f9fc; }
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 3vw, 2.1rem);
      font-weight: 700;
      color: var(--bg);
      margin-bottom: 16px;
    }
    .section-title span { color: var(--accent); }
    .section-sub { color: var(--gris); line-height: 1.75; font-size: 1.03rem; margin-bottom: 34px; }
    .section p + p { margin-top: 16px; }

    /* DATOS DE CONTACTO */
    .datos {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }
    .dato {
      background: #fff;
      border: 1.5px solid rgba(58,143,224,0.22);
      border-radius: 16px;
      padding: 22px 24px;
    }
    .dato h3 {
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 10px;
    }
    .dato p { color: #2d3748; line-height: 1.6; font-size: 1rem; }
    .dato p strong { color: var(--bg); }
    .dato a { color: var(--surface); font-weight: 600; text-decoration: none; }
    .dato a:hover { text-decoration: underline; }
    .dato-nota { display: block; margin-top: 8px; font-size: 0.86rem; color: var(--gris); }

    /* MAPA */
    .mapa-wrap {
      border-radius: 18px;
      overflow: hidden;
      border: 1.5px solid rgba(58,143,224,0.22);
      box-shadow: 0 6px 24px rgba(13,43,107,0.08);
      line-height: 0;
    }
    .mapa-wrap iframe { width: 100%; height: 400px; border: 0; display: block; }
    .mapa-link { display: inline-block; margin-top: 18px; color: var(--accent); font-weight: 700; text-decoration: none; }
    .mapa-link:hover { text-decoration: underline; }

    /* SERVICIOS */
    .servicios { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    .servicio {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #fff;
      border: 1.5px solid rgba(58,143,224,0.22);
      border-radius: 14px;
      padding: 18px 20px;
      color: #2d3748;
      text-decoration: none;
      font-weight: 600;
      transition: border-color 0.2s, transform 0.2s;
    }
    .servicio:hover { border-color: var(--accent); transform: translateY(-2px); }
    .servicio .ico { font-size: 1.3rem; }

    /* DESTACADO */
    .destacado {
      background: var(--surface);
      color: #fff;
      border-radius: 20px;
      padding: 38px 34px;
    }
    .destacado h3 { font-family: var(--font-display); font-size: 1.25rem; color: var(--accent); margin-bottom: 14px; }
    .destacado p { opacity: 0.9; line-height: 1.8; }
    .destacado p + p { margin-top: 14px; }
    @media (max-width: 600px) { .destacado { padding: 28px 22px; } }

    /* RESEÑAS */
    .rating-head { text-align: center; margin-bottom: 34px; }
    .rating-num { font-family: var(--font-display); font-size: 3rem; font-weight: 700; color: var(--bg); line-height: 1; }
    .rating-stars { display: block; color: #F6AD55; font-size: 1.15rem; letter-spacing: 3px; margin: 8px 0 10px; }
    .rating-sub { color: var(--gris); font-size: 1rem; }
    .resenas { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
    .resena {
      background: #fff;
      border: 1.5px solid rgba(58,143,224,0.2);
      border-radius: 16px;
      padding: 24px;
      display: flex;
      flex-direction: column;
    }
    .resena-hook { font-family: var(--font-display); font-weight: 700; color: var(--bg); font-size: 1.02rem; margin-bottom: 10px; }
    .resena p { color: var(--gris); line-height: 1.7; font-size: 0.95rem; flex: 1; }
    .resena-autor { margin-top: 16px; font-size: 0.85rem; color: var(--gris); }
    .resena-autor strong { display: block; color: var(--bg); font-size: 0.95rem; }
    .ver-resenas { display: inline-block; margin-top: 26px; color: var(--accent); font-weight: 700; text-decoration: none; }
    .ver-resenas:hover { text-decoration: underline; }

    /* FAQ */
    .faq { display: flex; flex-direction: column; gap: 18px; }
    .faq-item {
      background: #fff;
      border: 1.5px solid rgba(58,143,224,0.2);
      border-radius: 16px;
      padding: 24px 28px;
    }
    .faq-item h3 {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--bg);
      margin-bottom: 10px;
    }
    .faq-item p { color: var(--gris); line-height: 1.75; font-size: 1rem; }

    /* CTA FINAL */
    .cta-section {
      background: linear-gradient(135deg, var(--bg) 0%, var(--surface) 100%);
      color: #fff;
      text-align: center;
      padding: 76px 20px;
    }
    .cta-section h2 {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 3.5vw, 2.2rem);
      font-weight: 700;
      margin-bottom: 16px;
    }
    .cta-section p { font-size: 1.05rem; opacity: 0.86; margin: 0 auto 32px; max-width: 560px; line-height: 1.7; }

    /* NAV INFERIOR */
    .otra-sucursal { text-align: center; padding: 34px 20px 12px; color: var(--gris); font-size: 0.98rem; }
    .otra-sucursal a { color: var(--accent); font-weight: 700; text-decoration: none; }
    .otra-sucursal a:hover { text-decoration: underline; }
    .back-link {
      display: block;
      text-align: center;
      padding: 12px 20px 34px;
      color: var(--accent);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
    }
    .back-link:hover { text-decoration: underline; }
  </style>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <span class="hero-tag">Sucursal · Plaza Cedros, Arboledas</span>
      <h1>Óptica Jarmar Arboledas<br>en <span>Tuxtla Gutiérrez</span></h1>
      <p>Ópticas Jarmar Arboledas es una óptica en Tuxtla Gutiérrez especializada en salud visual, lentes graduados, lentes de contacto y exámenes de la vista. Desde 1966 cuidamos la visión de las familias chiapanecas con atención profesional y soluciones visuales de precisión.</p>
      <div class="hero-rating">
        <span class="stars">★★★★★</span>
        <span>4.9 · más de 880 reseñas en Google</span>
      </div>
      <div class="btn-row">
        <a href={sucursal.whatsapp} target="_blank" rel="noopener" class="btn-cta btn-wa">Agendar por WhatsApp</a>
        <a href={`tel:${sucursal.telefonoIntl}`} class="btn-cta btn-tel">Llamar {sucursal.telefono}</a>
        <a href={sucursal.mapa} target="_blank" rel="noopener" class="btn-cta btn-ghost">Cómo llegar</a>
      </div>
    </div>
  </section>

  <!-- DATOS DE LA SUCURSAL -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Ubicación, horario y <span>contacto</span></h2>
      <p class="section-sub">Todo lo que necesitas para visitarnos en nuestra sede de Arboledas, en Tuxtla Gutiérrez.</p>
      <div class="datos">
        <div class="dato">
          <h3>Ubicación</h3>
          <p>
            <strong>{sucursal.direccion}</strong><br>
            {sucursal.ciudad}, {sucursal.estado}
            <span class="dato-nota">Con estacionamiento dentro de la plaza.</span>
          </p>
        </div>
        <div class="dato">
          <h3>Horario</h3>
          <p>
            <strong>Lunes a viernes:</strong> 9:00 – 20:00<br>
            <strong>Sábado:</strong> 9:00 – 18:00
            <span class="dato-nota">Domingos y días festivos: confirma por WhatsApp antes de venir.</span>
          </p>
        </div>
        <div class="dato">
          <h3>Teléfono</h3>
          <p>
            <a href={`tel:${sucursal.telefonoIntl}`}>{sucursal.telefono}</a>
            <span class="dato-nota">Atención en horario de sucursal.</span>
          </p>
        </div>
        <div class="dato">
          <h3>WhatsApp</h3>
          <p>
            <a href={sucursal.whatsapp} target="_blank" rel="noopener">Escribir al {sucursal.telefono}</a>
            <span class="dato-nota">La vía más rápida para agendar tu cita.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- MAPA -->
  <section class="section section--alt">
    <div class="container">
      <h2 class="section-title">Cómo llegar a <span>Arboledas</span></h2>
      <p class="section-sub">Estamos en Plaza Cedros, sobre la colonia Arboledas, en el norte-poniente de Tuxtla Gutiérrez. Abre el mapa para trazar tu ruta desde donde estés.</p>
      <div class="mapa-wrap">
        <iframe
          src={sucursal.embed}
          title="Mapa de Ópticas Jarmar Arboledas — Plaza Cedros, Tuxtla Gutiérrez"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <a href={sucursal.mapa} target="_blank" rel="noopener" class="mapa-link">Abrir en Google Maps →</a>
    </div>
  </section>

  <!-- QUÉ ENCUENTRAS AQUÍ -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Servicios en la sucursal <span>Arboledas</span></h2>
      <p class="section-sub">Nuestro modelo de Clínica Óptica Boutique reúne en un mismo espacio el diagnóstico clínico, las soluciones ópticas y la boutique de armazones.</p>
      <div class="servicios">
        <a href="/chiapas/estudio-de-la-vista" class="servicio"><span class="ico">👁</span> Estudio de la vista</a>
        <a href="/chiapas/lentes-graduados" class="servicio"><span class="ico">👓</span> Lentes graduados</a>
        <a href="/chiapas/lentes-de-contacto" class="servicio"><span class="ico">🔵</span> Lentes de contacto</a>
        <a href="/chiapas/lentes-esclerales" class="servicio"><span class="ico">⭐</span> Lentes esclerales</a>
        <a href="/chiapas/queratocono" class="servicio"><span class="ico">🩺</span> Queratocono</a>
        <a href="/chiapas/examen-ninos" class="servicio"><span class="ico">🧒</span> Examen visual infantil</a>
        <a href="/chiapas/lentes-luz-azul" class="servicio"><span class="ico">💻</span> Lentes de luz azul</a>
        <a href="/chiapas/lentes-de-sol" class="servicio"><span class="ico">😎</span> Lentes de sol</a>
      </div>
    </div>
  </section>

  <!-- CENTRO VISUAL -->
  <section class="section section--alt">
    <div class="container">
      <div class="destacado">
        <h3>Nuestra sede clínica en Tuxtla</h3>
        <p>Arboledas es la sucursal donde en 2020 abrimos el <strong>Centro Visual</strong>, en alianza con el centro oftalmológico de referencia en Chiapas. Esa alianza cambió lo que podemos hacer en una sola visita: si durante tu revisión encontramos algo que necesita valoración médica —presión ocular alta, retinopatía, una córnea que se está deformando— te referimos con oftalmología sin que tengas que empezar el trámite desde cero en otro lado.</p>
        <p>Aquí también trabaja el área de <a href="/chiapas/lentes-esclerales" style="color:#3A8FE0;font-weight:700;">contactología especializada</a>, con más de 10 años adaptando lentes esclerales para queratocono, córneas irregulares y pacientes post-trasplante que llegan desde otros municipios y estados del sureste. Al frente del equipo de Chiapas está el <a href="/hectorpineda/" style="color:#3A8FE0;font-weight:700;">Opt. Héctor Pineda</a>, junto a nuestro Optometrista Director, el <a href="/jorgearanda/" style="color:#3A8FE0;font-weight:700;">Opt. Jorge Aranda Tello</a>.</p>
      </div>
    </div>
  </section>

  <!-- RESEÑAS -->
  <section class="section">
    <div class="container">
      <div class="rating-head">
        <span class="rating-num">4.9</span>
        <span class="rating-stars">★★★★★</span>
        <p class="rating-sub">Más de 880 reseñas de pacientes reales en Google, entre nuestras sucursales de Chiapas y Tijuana.</p>
      </div>
      <div class="resenas">
        <div class="resena">
          <p class="resena-hook">Cambié mis lentes y desaparecieron los dolores.</p>
          <p>Llevaba años con dolores de cabeza y pensé que era estrés. En Jarmar descubrieron que tenía la graduación mal desde hacía tiempo. No puedo creer que esperé tanto.</p>
          <div class="resena-autor"><strong>Mariana R.</strong> Reseña en Google</div>
        </div>
        <div class="resena">
          <p class="resena-hook">Ya usa sus lentes y mejoró mucho en la escuela.</p>
          <p>Llevé a mi hijo de 7 años porque la maestra dijo que se distraía mucho. Tenía miopía. La atención fue muy amable y paciente con él.</p>
          <div class="resena-autor"><strong>Carlos M.</strong> Reseña en Google</div>
        </div>
        <div class="resena">
          <p class="resena-hook">Todo el mundo me pregunta dónde los compré.</p>
          <p>Me enamoré de los lentes Jarmar Eyewear. Son cómodos, ligeros y únicos. Nada que ver con los que había comprado antes en otro lugar.</p>
          <div class="resena-autor"><strong>Sofía T.</strong> Reseña en Google</div>
        </div>
      </div>
      <a href={sucursal.mapa} target="_blank" rel="noopener" class="ver-resenas">Ver las reseñas de Arboledas en Google →</a>
