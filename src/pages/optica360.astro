---
// Landing de oferta: Óptica 360 · Generación 2027. Ruta: /optica360 —
// página standalone (head propio, ver CLAUDE.md), con el mismo branding que
// /diagnostico360. Reemplaza a /aceleracion (redirige 301 en vercel.json).
//
// Una sola acción: hacer el Diagnóstico 360. No hay formularios aquí: los
// datos entran por el diagnóstico. Para el lead más caliente, link secundario
// a una llamada directa.
import { calendarioLink } from "../config/diagnostico";

// Links en un solo lugar. Los UTM de la visita se anexan solos al link del
// diagnóstico (ver el script al final).
const DIAGNOSTICO_URL = "/diagnostico360/";
const CALENDARIO_URL = calendarioLink;

const CTA_DIAGNOSTICO = "Haz gratis el Diagnóstico 360 de tu óptica";
const CTA_LLAMADA = "Agendar una llamada directa →";

// Sección de testimonios: queda oculta hasta tener testimonios REALES de la
// primera generación. No usar testimonios inventados.
const MOSTRAR_TESTIMONIOS = false;

const TITLE = "Óptica 360 · Generación 2027 | Ópticas Jarmar";
const DESCRIPTION =
  "6 meses para convertir tu óptica en una empresa rentable. Programa en línea para dueños de ópticas independientes. Una sola generación en 2027, solo 15 ópticas.";
const URL = "https://www.jarmar.com/optica360/";

const problemas = [
  "No sabes con certeza cuánto ganas por cada producto o servicio.",
  "Tienes armazones detenidos en vitrina desde hace meses.",
  "Compites por precio con cadenas y promociones.",
  "Cada vendedor atiende y vende a su manera.",
  "Los pacientes no regresan, y nadie les da seguimiento.",
  "Los pacientes nuevos llegan solo por recomendación o porque pasan enfrente.",
  "Si tú no estás, la óptica no avanza.",
];

const transformacion = [
  ["Decides por intuición", "Tomas decisiones con tus números"],
  ["Vendes por precio", "Te eligen por tu propuesta clínica"],
  ["Inventario detenido", "Compras con criterio y liberas flujo"],
  ["Pacientes que no regresan", "Un sistema de seguimiento y reactivación"],
  ["Dependes del boca a boca", "Atraes pacientes nuevos con Google, redes, WhatsApp y campañas digitales"],
  ["Todo depende de ti", "Un equipo con roles, procesos e indicadores"],
];

const etapas = [
  {
    titulo: "Etapa 1 · Resultados rápidos",
    meses: "Meses 1–2",
    texto: "Encontramos el dinero que tu óptica ya tiene en su base de pacientes, en el mostrador y en el inventario.",
  },
  {
    titulo: "Etapa 2 · Control y diferenciación",
    meses: "Meses 3–4",
    texto: "Ordenas tus números, defines lo que te hace distinto y pones tu óptica a punto en Google, redes y WhatsApp.",
  },
  {
    titulo: "Etapa 3 · Sistema y crecimiento",
    meses: "Meses 5–6",
    texto: "Estrategias digitales para atraer pacientes nuevos de forma constante, más equipo y operación para crecer sin depender de ti.",
  },
];

const formato = [
  ["💻", "<strong>En línea</strong>, sesiones grupales en vivo, 1 a 2 al mes."],
  ["🎥", "<strong>Todas las sesiones se graban</strong>: si no puedes asistir, no te pierdes nada."],
  ["⏱️", "<strong>4 horas a la semana</strong> entre sesión e implementación."],
  ["🛠️", "Implementación sobre tu propia óptica, con plantillas y herramientas listas."],
  ["🤝", "Acompañamiento y seguimiento entre sesiones."],
  ["👥", "Comunidad de 15 dueños de ópticas."],
];

const incluye = [
  "6 meses de programa en línea con sesiones en vivo.",
  "Grabación de todas las sesiones.",
  "Diagnóstico 360 inicial y auditoría final.",
  "Plantillas, herramientas y formatos de implementación.",
  "Seguimiento entre sesiones.",
  "Garantía de acompañamiento 1:1.",
];

const pasosAdmision = [
  ["Haz el Diagnóstico 360", "(5–7 min). Recibes tu resultado al momento."],
  ["Agenda tu lectura", "(20 min, sin costo). Revisamos tu resultado y tu plan de 90 días."],
  ["Admisión.", "Si tu óptica es candidata, te invitamos a la Generación 2027."],
];

// Mismo texto en el acordeón y en el JSON-LD FAQPage (regla de CLAUDE.md).
const faqs = [
  ["¿Cuándo empieza?", "En marzo de 2027. Son 6 meses, con 1 a 2 sesiones en vivo al mes."],
  ["¿Es presencial o en línea?", "100% en línea. Puedes participar desde cualquier ciudad."],
  ["¿Cuánto tiempo necesito?", "Alrededor de 4 horas a la semana, entre la sesión y la implementación en tu óptica."],
  ["¿Qué pasa si no puedo asistir a una sesión?", "Todas las sesiones se graban. Puedes verla después y seguir con la implementación."],
  ["¿Sirve si tengo una sola sucursal?", "Sí. El programa está pensado para ópticas independientes, con una o varias sucursales."],
  ["¿Cómo se paga?", "La inversión es de $29,000 MXN + IVA. Puedes pagarla en hasta 3 pagos, liquidados antes del arranque."],
  ["¿Cómo funciona la garantía?", "Medimos tus ventas adicionales en tu tablero desde el primer mes. Si al terminar el programa no igualan tu inversión, seguimos contigo 1:1 sin costo hasta lograrlo."],
  ["¿Por qué solo 15 ópticas?", "Para dar seguimiento real a cada óptica. Es una sola generación en 2027."],
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};

const anio = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="msvalidate.01" content="7BC48F9D0740327D02EED2218E21311A" />
  <meta name="theme-color" content="#071A3E" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION} />
  <link rel="canonical" href={URL} />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={URL} />
  <meta property="og:image" content="https://www.jarmar.com/logo-opticas-jarmar-color.png" />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:site_name" content="Ópticas Jarmar" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={TITLE} />
  <meta name="twitter:description" content={DESCRIPTION} />
  <meta name="twitter:image" content="https://www.jarmar.com/logo-opticas-jarmar-color.png" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://www.jarmar.com/#organization",
    "name": "Ópticas Jarmar",
    "alternateName": "Clínica Óptica Boutique Jarmar",
    "url": "https://www.jarmar.com/",
    "logo": "https://www.jarmar.com/logo-opticas-jarmar-color.png",
    "foundingDate": "1966",
    "description": "Clínica Óptica Boutique con más de 60 años cuidando la salud visual de México. Especialistas en lentes esclerales, con sucursales en Tuxtla Gutiérrez, Chiapas y Tijuana, Baja California.",
    "sameAs": [
      "https://www.facebook.com/opticasjarmarchiapas",
      "https://www.instagram.com/opticasjarmar/",
      "https://www.facebook.com/opticasjarmartijuana",
      "https://www.instagram.com/opticasjarmartijuana/"
    ]
  }</script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-17977352986"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-17977352986');
  </script>
  <!-- Microsoft Clarity -->
  <script type="text/javascript" is:inline>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xr1fwqa9cs");
  </script>

  <style is:global>
    :root {
      --bg: #071A3E;
      --surface: #0D2B6B;
      --accent: #3A8FE0;
      --accent-oscuro: #1A5BB5;
      --gris: #4A5568;
      --gris-claro: #F7F9FC;
      --borde: rgba(13,43,107,0.16);
      --exito: #2F855A;
      --ambar: #B7791F;
      --font-display: "Playfair Display", serif;
      --font-body: "DM Sans", system-ui, -apple-system, sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; font-family: var(--font-body); color: #1A202C; background: #fff; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    [hidden] { display: none !important; }
    img { max-width: 100%; }
    .container { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
    .angosto { max-width: 760px; }

    /* HEADER */
    .site-header { background: var(--bg); padding: 12px 0; }
    .site-header img { height: 30px; width: auto; display: block; }

    /* BOTONES */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-align: center;
      background: var(--accent); color: #fff; border: none; padding: 15px 28px; min-height: 52px; border-radius: 100px;
      font-family: var(--font-body); font-weight: 700; font-size: 1.02rem; line-height: 1.3; text-decoration: none; cursor: pointer;
      transition: opacity 0.2s, transform 0.2s;
    }
    .btn:hover { opacity: 0.92; transform: translateY(-2px); }
    a:focus-visible, button:focus-visible { outline: 3px solid rgba(58,143,224,0.6); outline-offset: 3px; }
    .link-sec { display: inline-flex; align-items: center; min-height: 44px; color: #9CCBF5; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
    .link-sec--claro { color: var(--accent-oscuro); }
    .ctas { display: flex; flex-direction: column; align-items: center; gap: 6px; margin-top: 24px; }
    .ctas .btn { width: 100%; max-width: 420px; }

    /* HERO */
    .hero { background: linear-gradient(135deg, var(--bg) 0%, var(--surface) 100%); color: #fff; padding: 28px 0 30px; text-align: center; }
    .eyebrow {
      display: inline-block; background: rgba(58,143,224,0.2); border: 1px solid var(--accent); color: #fff;
      border-radius: 100px; padding: 5px 14px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; margin-bottom: 16px;
    }
    .hero h1 { font-family: var(--font-display); font-size: clamp(1.75rem, 7.4vw, 3.3rem); line-height: 1.15; margin: 0 auto 14px; max-width: 820px; text-wrap: balance; }
    .hero .sub { font-size: 1.02rem; line-height: 1.6; opacity: 0.92; margin: 0 auto; max-width: 660px; text-wrap: pretty; }
    .hero .ctas { margin-top: 20px; }
    .franja {
      margin: 18px auto 0; max-width: 680px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.22);
      border-radius: 14px; padding: 11px 14px; font-size: 0.92rem; line-height: 1.55;
    }
    .franja strong { color: #FFD38A; }

    /* SECCIONES */
    .section { padding: 64px 0; }
    .section--alt { background: var(--gris-claro); }
    .section h2 { font-family: var(--font-display); color: var(--bg); font-size: clamp(1.55rem, 4.6vw, 2.3rem); line-height: 1.25; margin: 0 0 18px; text-wrap: balance; }
    .section p { color: var(--gris); line-height: 1.75; margin: 0 0 14px; font-size: 1.03rem; }
    .centro { text-align: center; }
    .centro p { margin-left: auto; margin-right: auto; }

    .problemas { list-style: none; padding: 0; margin: 20px 0 24px; display: grid; gap: 10px; }
    .problemas li { display: flex; gap: 12px; align-items: flex-start; background: #fff; border: 1.5px solid var(--borde); border-radius: 14px; padding: 14px 16px; color: #2D3748; line-height: 1.55; font-weight: 500; }
    .problemas li::before { content: ""; flex-shrink: 0; width: 10px; height: 10px; margin-top: 7px; border-radius: 50%; background: var(--ambar); }
    .cierre-problema { font-size: 1.1rem !important; color: var(--bg) !important; }

    /* HOY → AL TERMINAR */
    .trans { display: grid; gap: 12px; margin-top: 28px; }
    .trans-head { display: none; }
    .trans-fila { display: grid; gap: 8px; background: #fff; border: 1.5px solid var(--borde); border-radius: 16px; padding: 16px; }
    .trans-hoy, .trans-luego { display: block; line-height: 1.5; }
    .trans-hoy { color: var(--gris); }
    .trans-hoy::before { content: "Hoy: "; font-weight: 700; color: var(--ambar); }
    .trans-luego { color: var(--bg); font-weight: 700; }
    .trans-luego::before { content: "→ "; color: var(--exito); }

    /* ETAPAS */
    .etapas { list-style: none; padding: 0; margin: 28px 0; display: grid; gap: 14px; }
    .etapa { background: #fff; border: 1.5px solid rgba(58,143,224,0.22); border-radius: 18px; padding: 22px 20px; }
    .etapa-num { display: inline-flex; width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 700; align-items: center; justify-content: center; }
    .etapa h3 { font-family: var(--font-display); color: var(--bg); font-size: 1.2rem; margin: 12px 0 2px; }
    .etapa .meses { font-size: 0.85rem; font-weight: 700; color: var(--accent-oscuro); text-transform: uppercase; letter-spacing: 0.05em; }
    .etapa p { margin: 10px 0 0; font-size: 0.98rem; }
    .formato { background: var(--bg); color: #fff; border-radius: 20px; padding: 24px 20px; }
    .formato h3 { font-family: var(--font-display); font-size: 1.3rem; margin: 0 0 14px; }
    .formato ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
    .formato li { display: flex; gap: 12px; line-height: 1.55; color: rgba(255,255,255,0.9); }
    .formato li span:first-child { flex-shrink: 0; }
    .destacada { margin: 26px 0 0; padding: 18px 20px; border-left: 5px solid var(--accent); background: rgba(58,143,224,0.08); border-radius: 12px; font-size: 1.12rem !important; color: var(--bg) !important; }

    /* EQUIPO */
    .equipo { display: grid; gap: 18px; margin-top: 26px; }
    .persona { background: #fff; border: 1.5px solid var(--borde); border-radius: 20px; overflow: hidden; }
    .persona-foto { aspect-ratio: 4 / 3; background: linear-gradient(135deg, var(--bg), var(--surface)); }
    .persona-foto img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block; }
    .persona-cuerpo { padding: 20px; }
    .persona h3 { font-family: var(--font-display); color: var(--bg); font-size: 1.25rem; margin: 0 0 4px; }
    .persona .rol { font-size: 0.85rem; font-weight: 700; color: var(--accent-oscuro); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 10px; }
    .persona p { font-size: 0.98rem; margin: 0; }
    .jarmar-bloque { margin-top: 22px; text-align: center; padding: 22px 20px; border-radius: 18px; background: var(--gris-claro); }
    .jarmar-bloque strong { display: block; color: var(--bg); font-size: 1.05rem; margin-bottom: 6px; }
    .jarmar-bloque p { margin: 0 auto; max-width: 620px; }

    /* PARA QUIÉN */
    .para-quien { display: grid; gap: 16px; margin-top: 24px; }
    .columna { border-radius: 18px; padding: 22px 20px; background: #fff; border: 1.5px solid var(--borde); }
    .columna h3 { margin: 0 0 12px; font-size: 1.1rem; }
    .columna ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
    .columna li { display: flex; gap: 10px; line-height: 1.55; color: #2D3748; }
    .columna--si { border-color: rgba(47,133,90,0.4); }
    .columna--si h3 { color: var(--exito); }
    .columna--no h3 { color: #9B2C2C; }

    /* GARANTÍA */
    .garantia { background: linear-gradient(135deg, #0F3D2B 0%, #1C5C40 100%); color: #fff; text-align: center; }
    .garantia h2 { color: #fff; }
    .garantia p { color: rgba(255,255,255,0.92); }
    .sello { width: 76px; height: 76px; margin: 0 auto 16px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.5); display: flex; align-items: center; justify-content: center; font-size: 2.2rem; background: rgba(255,255,255,0.08); }
    .letra-chica { font-size: 0.86rem !important; opacity: 0.85; max-width: 600px; }

    /* INVERSIÓN */
    .inversion { max-width: 560px; margin: 24px auto 0; background: #fff; border: 2px solid var(--accent); border-radius: 22px; padding: 28px 22px; text-align: center; box-shadow: 0 10px 40px rgba(13,43,107,0.08); }
    .precio { font-family: var(--font-display); font-size: clamp(2.2rem, 9vw, 3rem); color: var(--bg); font-weight: 700; line-height: 1.1; }
    .precio small { font-family: var(--font-body); font-size: 1rem; font-weight: 600; color: var(--gris); }
    .pagos { margin: 8px 0 20px !important; }
    .incluye { list-style: none; padding: 0; margin: 0 0 22px; display: grid; gap: 10px; text-align: left; }
    .incluye li { display: flex; gap: 10px; line-height: 1.55; color: #2D3748; }
    .incluye li::before { content: "✓"; color: var(--exito); font-weight: 700; }
    .nota-impl { font-size: 0.93rem !important; margin-top: 14px !important; }

    /* ADMISIÓN */
    .pasos { list-style: none; padding: 0; margin: 26px 0; display: grid; gap: 14px; counter-reset: paso; }
    .pasos li { background: #fff; border: 1.5px solid var(--borde); border-radius: 18px; padding: 20px; display: flex; gap: 14px; align-items: flex-start; line-height: 1.55; color: var(--gris); }
    .pasos li::before { counter-increment: paso; content: counter(paso); flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: var(--bg); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .pasos strong { color: var(--bg); }

    /* FAQ */
    .faq { margin-top: 22px; border-top: 1px solid var(--borde); }
    .faq-item { border-bottom: 1px solid var(--borde); }
    .faq-q {
      width: 100%; min-height: 56px; display: flex; justify-content: space-between; align-items: center; gap: 16px; text-align: left;
      background: none; border: none; padding: 16px 0; cursor: pointer; font-family: var(--font-body); font-size: 1.02rem; font-weight: 700; color: var(--bg);
    }
    .faq-q .mas { flex-shrink: 0; font-size: 1.4rem; color: var(--accent-oscuro); transition: transform 0.2s; }
    .faq-q[aria-expanded="true"] .mas { transform: rotate(45deg); }
    .faq-a { padding: 0 0 18px; }
    .faq-a p { margin: 0; }

    /* CIERRE */
    .cierre { background: linear-gradient(135deg, var(--bg) 0%, var(--surface) 100%); color: #fff; text-align: center; }
    .cierre h2 { color: #fff; }
    .cierre p { color: rgba(255,255,255,0.88); }

    /* FOOTER */
    .site-footer { background: var(--bg); color: rgba(255,255,255,0.72); padding: 32px 20px 96px; text-align: center; font-size: 0.9rem; border-top: 1px solid rgba(255,255,255,0.08); }
    .site-footer img { height: 28px; width: auto; opacity: 0.85; margin-bottom: 12px; }
    .site-footer p { margin: 0 0 6px; line-height: 1.6; }
    .site-footer a { color: #9CCBF5; font-weight: 600; }

    /* CTA FIJO EN MÓVIL */
    .sticky {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: flex; align-items: center; gap: 12px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(7,26,62,0.97); color: #fff;
      box-shadow: 0 -6px 24px rgba(7,26,62,0.3); transform: translateY(110%); transition: transform 0.25s ease;
    }
    .sticky.visible { transform: none; }
    .sticky span { font-size: 0.86rem; font-weight: 600; line-height: 1.35; flex: 1; }
    .sticky .btn { padding: 10px 18px; min-height: 44px; font-size: 0.92rem; flex-shrink: 0; }

    @media (min-width: 768px) {
      .hero { padding: 64px 0 60px; }
      .hero .sub { font-size: 1.15rem; }
      .section { padding: 84px 0; }
      .trans { gap: 0; border: 1.5px solid var(--borde); border-radius: 18px; overflow: hidden; }
      .trans-head, .trans-fila { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: none; border-radius: 0; padding: 0; }
      .trans-head span { padding: 14px 22px; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
      .trans-head span:first-child { background: #FBF4E8; color: var(--ambar); }
      .trans-head span:last-child { background: var(--bg); color: #fff; }
      .trans-fila { border-top: 1px solid var(--borde); }
      .trans-hoy, .trans-luego { padding: 16px 22px; }
      .trans-hoy::before, .trans-luego::before { content: none; }
      .trans-luego { background: rgba(47,133,90,0.05); }
      .etapas { grid-template-columns: repeat(3, 1fr); }
      .formato { padding: 30px 32px; }
      .formato ul { grid-template-columns: 1fr 1fr; gap: 14px 28px; }
      .equipo { grid-template-columns: 1fr 1fr; }
      .para-quien { grid-template-columns: 1fr 1fr; }
      .pasos { grid-template-columns: repeat(3, 1fr); }
      .pasos li { flex-direction: column; }
      .sticky { display: none; }
      .site-footer { padding-bottom: 32px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .btn:hover { transform: none; }
      .sticky { transition: none; }
    }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="container">
      <a href="/" aria-label="Ópticas Jarmar — ir al inicio">
        <img src="/logo-opticas-jarmar-blanco-esp.png" alt="Ópticas Jarmar" width="131" height="30" />
      </a>
    </div>
  </header>

  <main>
    <!-- 1 · HERO -->
    <section class="hero" id="hero">
      <div class="container">
        <span class="eyebrow">Óptica 360 · Generación 2027</span>
        <h1>6 meses para convertir tu óptica en una empresa rentable.</h1>
        <p class="sub">Un programa para dueños de ópticas independientes que quieren más control, más ventas y una óptica que no dependa solo de ellos. Construido desde 60 años de operar Ópticas Jarmar.</p>
        <div class="ctas">
          <a class="btn" href={DIAGNOSTICO_URL} data-diagnostico="hero">{CTA_DIAGNOSTICO}</a>
          <a class="link-sec" href={CALENDARIO_URL} target="_blank" rel="noopener" data-llamada="hero">{CTA_LLAMADA}</a>
        </div>
        <p class="franja">Una sola generación en 2027 · <strong>Solo 15 ópticas</strong> · Inicia en <strong>marzo 2027</strong> · En línea</p>
      </div>
    </section>

    <!-- 2 · EL PROBLEMA -->
    <section class="section section--alt">
      <div class="container angosto">
        <h2>Tu óptica funciona. Pero ¿es un buen negocio?</h2>
        <p>La mayoría de las ópticas independientes tienen buenos optometristas, pacientes leales y años de experiencia. Y aun así:</p>
        <ul class="problemas">
          {problemas.map((p) => <li>{p}</li>)}
        </ul>
        <p class="cierre-problema"><strong>Una buena óptica no siempre es un buen negocio.</strong> Óptica 360 existe para cerrar esa brecha.</p>
      </div>
    </section>

    <!-- 3 · EL RESULTADO -->
    <section class="section">
      <div class="container angosto">
        <h2 class="centro">De óptica tradicional a empresa profesional</h2>
        <div class="trans" role="table" aria-label="Hoy contra al terminar Óptica 360">
          <div class="trans-head" role="row"><span role="columnheader">Hoy</span><span role="columnheader">Al terminar Óptica 360</span></div>
          {transformacion.map(([hoy, luego]) => (
            <div class="trans-fila" role="row">
              <span class="trans-hoy" role="cell">{hoy}</span>
              <span class="trans-luego" role="cell">{luego}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4 · CÓMO FUNCIONA -->
    <section class="section section--alt">
      <div class="container">
        <h2 class="centro">6 meses. 3 etapas. Resultados desde el primer mes.</h2>
        <ol class="etapas">
          {etapas.map((e, i) => (
            <li class="etapa">
              <span class="etapa-num" aria-hidden="true">{i + 1}</span>
              <h3>{e.titulo}</h3>
              <span class="meses">{e.meses}</span>
              <p>{e.texto}</p>
            </li>
          ))}
        </ol>
        <div class="formato">
          <h3>Formato</h3>
          <ul>
            {formato.map(([ico, t]) => <li><span aria-hidden="true">{ico}</span><span set:html={t} /></li>)}
          </ul>
        </div>
        <p class="destacada">No es un curso. <strong>Cada sesión deja algo funcionando en tu óptica.</strong></p>
      </div>
    </section>

    <!-- 5 · QUIÉN LO IMPARTE -->
    <section class="section">
      <div class="container">
        <h2 class="centro">Dos perspectivas, un mismo objetivo</h2>
        <div class="equipo">
          <article class="persona">
            <div class="persona-foto">
              <img src="/opt-jorge-aranda-tello-jarmar.jpeg" alt="Jorge Aranda, optometrista de Ópticas Jarmar" width="960" height="1280" loading="lazy" />
            </div>
            <div class="persona-cuerpo">
              <h3>Jorge Aranda</h3>
              <p class="rol">Criterio óptico</p>
              <p>Optometrista desde 1994. Más de 30 años en práctica clínica y al frente de Ópticas Jarmar. Referente en contactología especializada y adaptación de lentes de contacto esclerales. Conferencista en congresos de optometría nacionales e internacionales y creador del primer programa de formación para dueños de ópticas de Jarmar.</p>
            </div>
          </article>
          <article class="persona">
            <div class="persona-foto">
              <img src="/german-gonzalez-aranda-jarmar.jpg" alt="Germán González, de Ópticas Jarmar" width="1280" height="914" loading="lazy" />
            </div>
            <div class="persona-cuerpo">
              <h3>Germán González</h3>
              <p class="rol">Sistema de crecimiento</p>
              <p>10 años liderando estrategia, finanzas, digitalización y marketing de crecimiento en negocios de distintas industrias. Diseña los sistemas comerciales, digitales y de medición que convierten la operación en resultados.</p>
            </div>
          </article>
        </div>
        <div class="jarmar-bloque">
          <strong>Ópticas Jarmar · Clínica Óptica Boutique desde 1966</strong>
          <p>No enseñamos teoría de administración. Enseñamos lo que nos ha funcionado operando una óptica real en Tuxtla Gutiérrez y Tijuana.</p>
        </div>
      </div>
    </section>

    <!-- TESTIMONIOS: oculta hasta tener testimonios reales de alumni (MOSTRAR_TESTIMONIOS). -->
    <section class="section section--alt" id="testimonios" hidden={!MOSTRAR_TESTIMONIOS}>
      <div class="container angosto">
        <h2 class="centro">Lo que dicen los dueños de ópticas</h2>
        {/* Agregar aquí solo testimonios reales, con autorización de cada participante. */}
      </div>
    </section>

    <!-- 6 · PARA QUIÉN ES -->
    <section class="section section--alt">
      <div class="container angosto">
        <h2 class="centro">¿Óptica 360 es para ti?</h2>
        <div class="para-quien">
          <div class="columna columna--si">
            <h3>Es para ti si:</h3>
            <ul>
              <li><span aria-hidden="true">✓</span><span>Eres dueño(a), socio(a) u optometrista propietario de una óptica independiente.</span></li>
              <li><span aria-hidden="true">✓</span><span>Tu óptica ya opera, con o sin sucursales, y quieres que sea más rentable.</span></li>
              <li><span aria-hidden="true">✓</span><span>Estás dispuesto(a) a implementar, no solo a aprender.</span></li>
            </ul>
          </div>
          <div class="columna columna--no">
            <h3>No es para ti si:</h3>
            <ul>
              <li><span aria-hidden="true">✕</span><span>Buscas una fórmula mágica sin hacer cambios.</span></li>
              <li><span aria-hidden="true">✕</span><span>Solo quieres un diploma o un curso más.</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 7 · GARANTÍA -->
    <section class="section garantia">
      <div class="container angosto">
        <div class="sello" aria-hidden="true">🛡️</div>
        <h2>Tu inversión de vuelta en ventas. Si no, seguimos contigo.</h2>
        <p>Si al terminar el programa las acciones que implementaste no te han generado <strong>ventas adicionales al menos iguales a tu inversión</strong>, <strong>te acompañamos 1:1 sin costo hasta que lo logres.</strong></p>
        <p class="letra-chica">Aplica para participantes que asistan a las sesiones (en vivo o grabadas), implementen las acciones del programa y registren sus resultados en su tablero.</p>
      </div>
    </section>

    <!-- 8 · INVERSIÓN -->
    <section class="section">
      <div class="container">
        <h2 class="centro">Inversión</h2>
        <div class="inversion">
          <div class="precio">$29,000 MXN <small>+ IVA</small></div>
          <p class="pagos"><strong>Hasta 3 pagos</strong>, liquidados antes del arranque en marzo 2027.</p>
          <ul class="incluye">
            {incluye.map((t) => <li>{t}</li>)}
          </ul>
          <a class="btn" href={DIAGNOSTICO_URL} data-diagnostico="inversion">{CTA_DIAGNOSTICO}</a>
          <p class="nota-impl"><em>¿Prefieres que alguien lo implemente contigo?</em> También ofrecemos implementación directa en tu óptica. Se cotiza aparte, según lo que necesites.</p>
        </div>
      </div>
    </section>

    <!-- 9 · ADMISIÓN -->
    <section class="section section--alt">
      <div class="container">
        <h2 class="centro">Una sola generación. 15 lugares. Así se seleccionan.</h2>
        <ol class="pasos">
          {pasosAdmision.map(([t, d]) => <li><span><strong>{t}</strong> {d}</span></li>)}
        </ol>
        <p class="destacada">Las 15 ópticas de la Generación 2027 se seleccionan a partir del Diagnóstico 360. <strong>No habrá otra generación en 2027.</strong></p>
        <div class="ctas">
          <a class="btn" href={DIAGNOSTICO_URL} data-diagnostico="admision">Hacer mi Diagnóstico 360</a>
        </div>
      </div>
    </section>

    <!-- 10 · PREGUNTAS FRECUENTES -->
    <section class="section">
      <div class="container angosto">
        <h2 class="centro">Preguntas frecuentes</h2>
        <div class="faq">
          {faqs.map(([q, a], i) => (
            <div class="faq-item">
              <h3 style="margin:0">
                <button type="button" class="faq-q" aria-expanded="false" aria-controls={`faq-${i}`} id={`faq-q-${i}`}>
                  <span>{q}</span><span class="mas" aria-hidden="true">+</span>
                </button>
              </h3>
              <div class="faq-a" id={`faq-${i}`} role="region" aria-labelledby={`faq-q-${i}`} hidden>
                <p>{a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 11 · CIERRE -->
    <section class="section cierre" id="cierre">
      <div class="container angosto">
        <h2>Una buena óptica merece ser un buen negocio.</h2>
        <p>Óptica 360 · Generación 2027 · Solo 15 ópticas · Inicia en marzo.</p>
        <div class="ctas">
          <a class="btn" href={DIAGNOSTICO_URL} data-diagnostico="cierre">Haz gratis el Diagnóstico 360</a>
          <a class="link-sec" href={CALENDARIO_URL} target="_blank" rel="noopener" data-llamada="cierre">{CTA_LLAMADA}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <img src="/logo-opticas-jarmar-blanco-esp.png" alt="Ópticas Jarmar" width="122" height="28" />
    <p>Clínica Óptica Boutique desde 1966 · Tuxtla Gutiérrez y Tijuana</p>
    <p><a href="/">Ir al sitio de Ópticas Jarmar</a></p>
    <p style="opacity:0.6;">© {anio} Ópticas Jarmar</p>
  </footer>

  <!-- CTA fijo en móvil: aparece cuando el hero sale de pantalla y se oculta en el cierre -->
  <div class="sticky" id="sticky" aria-hidden="true">
    <span>Haz el Diagnóstico 360 · Solo 15 lugares</span>
    <a class="btn" href={DIAGNOSTICO_URL} data-diagnostico="sticky" tabindex="-1">Empezar</a>
  </div>

  <script>
    // gtag y clarity los carga el <head>; si un bloqueador los quita, la
    // página funciona igual.
    function track(evento: string, params: Record<string, string> = {}) {
      const w = window as unknown as { gtag?: (...a: unknown[]) => void; clarity?: (...a: unknown[]) => void };
      try { w.gtag?.("event", evento, { event_category: "optica360", ...params }); } catch {}
      try { w.clarity?.("event", evento); } catch {}
    }

    track("optica360_view");

    // Conserva los UTM (y cualquier query de la visita) al ir al diagnóstico,
    // para saber de qué canal viene cada diagnóstico.
    if (location.search) {
      document.querySelectorAll<HTMLAnchorElement>("a[data-diagnostico]").forEach((a) => {
        const url = new URL(a.getAttribute("href")!, location.origin);
        new URLSearchParams(location.search).forEach((v, k) => url.searchParams.set(k, v));
        a.href = url.pathname + url.search;
      });
    }

    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const diag = t.closest<HTMLElement>("[data-diagnostico]");
      if (diag) track("optica360_clic_diagnostico", { ubicacion: diag.dataset.diagnostico! });
      const llamada = t.closest<HTMLElement>("[data-llamada]");
      if (llamada) track("optica360_clic_llamada", { ubicacion: llamada.dataset.llamada! });
    });

    // FAQ: acordeón con una pregunta abierta a la vez (botones nativos: Tab +
    // Enter/Espacio funcionan con teclado).
    const preguntas = [...document.querySelectorAll<HTMLButtonElement>(".faq-q")];
    preguntas.forEach((btn) => {
      btn.addEventListener("click", () => {
        const abrir = btn.getAttribute("aria-expanded") !== "true";
        preguntas.forEach((b) => {
          b.setAttribute("aria-expanded", "false");
          document.getElementById(b.getAttribute("aria-controls")!)!.hidden = true;
        });
        if (abrir) {
          btn.setAttribute("aria-expanded", "true");
          document.getElementById(btn.getAttribute("aria-controls")!)!.hidden = false;
          track("optica360_faq_abierta", { pregunta: btn.querySelector("span")!.textContent!.trim() });
        }
      });
    });

    // CTA fijo: visible cuando el hero ya no está en pantalla y el cierre aún no.
    const sticky = document.getElementById("sticky")!;
    const stickyBtn = sticky.querySelector("a")!;
    let heroVisible = true;
    let cierreVisible = false;
    const actualizar = () => {
      const ver = !heroVisible && !cierreVisible;
      sticky.classList.toggle("visible", ver);
      sticky.setAttribute("aria-hidden", String(!ver));
      stickyBtn.tabIndex = ver ? 0 : -1;
    };
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([e]) => { heroVisible = e.isIntersecting; actualizar(); }).observe(document.getElementById("hero")!);
      new IntersectionObserver(([e]) => { cierreVisible = e.isIntersecting; actualizar(); }).observe(document.getElementById("cierre")!);
    }
  </script>
</body>
</html>
